{
    "id": "osmium-cloudflare",
    "name": "Osmium Cloudflare",
    "version": "0.3.1",
    "description": "Clears the Cloudflare cache for you: automatically after every admin or assistant change, from a button, from a deploy script, and from the assistant (MCP). Also toggles development mode",
    "category": "performance",
    "website": "https://www.cloudflare.com",
    "account": {"required": "free"},
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",
    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1"
    },
    "autoload": [
        "models"
    ],
    "hooks": {
        "content.changed": [
            "Osmium\\Services\\Cloudflare\\Models\\CloudflareHooks::contentChanged"
        ],
        "admin.status_icons": [
            "Osmium\\Services\\Cloudflare\\Models\\CloudflareStatusIcon::icons"
        ],
        "mcp.tools": [
            "Osmium\\Services\\Cloudflare\\Models\\CloudflareMcp::tools"
        ]
    },
    "admin": {
        "menu": {
            "section": "Content",
            "items": [
                {
                    "id": "cloudflare",
                    "label": "Cloudflare",
                    "icon": "bx bx-cloud",
                    "color": "#f6821f",
                    "route": "admin/settings/cloudflare",
                    "activePattern": "admin/settings/cloudflare",
                    "role": null
                }
            ]
        },
        "routes": {
            "admin/settings/cloudflare": {
                "controller": "controllers/CloudflareController.php",
                "class": "Osmium\\Services\\Cloudflare\\Controllers\\CloudflareController",
                "method": "index",
                "title": "Cloudflare"
            }
        }
    },
    "setup": {
        "postInstallNote": "Open Service Settings > Cloudflare and enter an API token with the Cache Purge permission, the zone ID and the site's hostnames, then press Test connection. After that every change saved in the admin or by an assistant clears the cache for the site's hostnames (at most 4 times a minute). The token is kept only in this site's config file. Deploy scripts can run: php app/services/osmium-cloudflare/cloudflare.php purge"
    }
}
